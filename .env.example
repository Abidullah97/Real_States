# PostgreSQL connection string. On Vercel this must be a hosted database, not localhost.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/estate_house?schema=public"
AUTH_SECRET="generate-a-unique-secret-with-openssl-rand-base64-32"
# Not needed on Vercel or in development (detected automatically). Set "true" only on other hosts behind a trusted proxy.
AUTH_TRUST_HOST="true"
# Canonical site URL; use your https:// domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Resend API key and verified sender for verification and password reset emails
EMAIL_FROM=""
EMAIL_API_KEY=""
# Cloudinary credentials for signed listing and seller-submission image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Supabase Storage for images (used when Cloudinary is not configured). Create the bucket by running
# `npm run db:migrate` against the Supabase database. SUPABASE_SECRET_KEY is server-only: never add NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="property-images"
# Optional Google Maps Embed API key
NEXT_PUBLIC_MAP_API_KEY=""
# Optional public social profile URLs (https only). Footer icons appear only when set.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
