generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OWNER
  AGENT
  ADMIN
  SUPER_ADMIN
}
enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  SOLD
  RENTED
  ARCHIVED
  REJECTED
}
enum ListingType {
  SALE
  RENT
}
enum InquiryStatus {
  NEW
  READ
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}
enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
}
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  role Role @default(USER)
  disabledAt DateTime?
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  sessions Session[]
  properties Property[]
  assignedInquiries Inquiry[] @relation("AssignedInquiries")
  favorites Favorite[]
  inquiries Inquiry[]
  agentProfile AgentProfile?
  submissions PropertySubmission[]
  agentListings Property[] @relation("AgentListings")
  notifications Notification[]
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}
model Session {
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([sessionToken])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@id([identifier, token])
}
model Agency {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String? @db.Text
  website String?
  createdAt DateTime @default(now())
  agents AgentProfile[]
}
model AgentProfile {
  id String @id @default(cuid())
  userId String @unique
  agencyId String?
  bio String? @db.Text
  phone String?
  location String?
  experienceYears Int?
  specialization String?
  status AgentStatus @default(APPROVED)
  appliedAt DateTime @default(now())
  reviewedAt DateTime?
  rejectionReason String?
  verifiedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  @@index([agencyId])
  @@index([status])
}
model Location {
  id String @id @default(cuid())
  country String
  province String?
  city String
  area String?
  locality String?
  latitude Float?
  longitude Float?
  properties Property[]
  @@index([city, locality])
}
model Property {
  id String @id @default(cuid())
  reference String @unique
  slug String @unique
  title String
  description String @db.Text
  listingType ListingType
  status ListingStatus @default(DRAFT)
  propertyType String
  price Decimal @db.Decimal(16, 2)
  currency String @default("PKR")
  area Decimal @db.Decimal(12, 2)
  areaUnit String
  bedrooms Int @default(0)
  bathrooms Int @default(0)
  parking Int @default(0)
  address String?
  featured Boolean @default(false)
  featuredOrder Int @default(0)
  featuredUntil DateTime?
  rejectionReason String?
  publishedAt DateTime?
  ownerId String?
  agentId String?
  locationId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  agent User? @relation("AgentListings", fields: [agentId], references: [id], onDelete: SetNull)
  location Location @relation(fields: [locationId], references: [id])
  images PropertyImage[]
  features PropertyFeature[]
  favorites Favorite[]
  inquiries Inquiry[]
  @@index([status, listingType, publishedAt])
  @@index([locationId, propertyType])
  @@index([price, bedrooms])
  @@index([featured, featuredOrder])
  @@index([agentId])
}
model PropertyImage {
  id String @id @default(cuid())
  propertyId String
  url String
  publicId String?
  alt String
  position Int @default(0)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([propertyId, position])
}
model PropertyFeature {
  id String @id @default(cuid())
  propertyId String
  name String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@unique([propertyId, name])
}
model Favorite {
  userId String
  propertyId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@id([userId, propertyId])
  @@index([propertyId])
}
model Inquiry {
  id String @id @default(cuid())
  propertyId String?
  userId String?
  name String
  email String
  phone String?
  message String @db.Text
  status InquiryStatus @default(NEW)
  assignedToId String?
  internalNotes String? @db.Text
  createdAt DateTime @default(now())
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([propertyId, createdAt])
  @@index([assignedToId, status])
}
model PropertySubmission {
  id String @id @default(cuid())
  submitterId String?
  status SubmissionStatus @default(PENDING)
  payload Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submitter User? @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entity String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
model RateLimitBucket {
  id String @id
  count Int @default(1)
  resetAt DateTime
  @@index([resetAt])
}
model Testimonial {
  id String @id @default(cuid())
  name String
  context String?
  quote String @db.Text
  rating Int?
  published Boolean @default(false)
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, position])
}
model SiteSettings {
  id String @id @default("site")
  siteName String?
  logoUrl String?
  faviconUrl String?
  websiteUrl String?
  heroHeading String?
  heroDescription String?
  heroImageUrl String?
  featuredLimit Int @default(6)
  showFeatured Boolean @default(true)
  showLocations Boolean @default(true)
  showCategories Boolean @default(true)
  showLatest Boolean @default(true)
  showTestimonials Boolean @default(true)
  showAgents Boolean @default(true)
  seoTitle String?
  seoDescription String?
  seoKeywords String?
  ogImageUrl String?
  contactEmail String?
  contactPhone String?
  officeAddress String?
  officeHours String?
  instagramUrl String?
  facebookUrl String?
  linkedinUrl String?
  updatedAt DateTime @updatedAt
}
model PropertyCategory {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String?
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
